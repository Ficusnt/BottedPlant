{
  "name": "bottedplant",
  "version": "1.8.0",
  "description": "Discord bot for YouTube audio and reminders \u2014 with a native slash command menu.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --optimize-for-size src/index.js",
    "start:prod": "node --max-old-space-size=256 --optimize-for-size dist/index.js",
    "dev": "node --max-old-space-size=256 --optimize-for-size scripts/dev.js",
    "build": "pnpm exec node --optimize-for-size esbuild.config.js --production",
    "build:dev": "pnpm exec node esbuild.config.js",
    "build:watch": "pnpm exec node esbuild.config.js --watch",
    "test": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "doc": "jsdoc -c jsdoc.json",
    "setup": "node scripts/setup-ytdlp-conf.js",
    "generate-cookies": "node scripts/generate-cookies.js",
    "postinstall": "node scripts/setup-ytdlp-conf.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@discord-player/extractor": "^7.2.0",
    "@discordjs/voice": "^0.19.2",
    "discord-player": "^7.0.0",
    "discord-player-googlevideo": "^0.2.7",
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.0.8",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "yt-dlp-exec": "^1.0.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@types/node": "^20.14.0",
    "babel-jest": "^30.5.2",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.3",
    "typescript": "^5.4.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
