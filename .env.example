# Discord bot token (required)
# Get it from: https://discord.com/developers/applications → Your App → Bot → Token
DISCORD_TOKEN=your-token-here

# Bot prefix (optional, default: !bp)
BOT_PREFIX=/bp

# Bot name (optional, default: BottedPlant)
BOT_NAME=BottedPlant

# YouTube bypass for bot detection (optional, default: embed hack)
# The bot uses the EMBED HACK (player_client=web_embedded) configured in
# node_modules/@distube/yt-dlp/bin/yt-dlp.conf — no cookies needed.
# This works because Brave/Chrome now encrypt cookies with DPAPI which
# yt-dlp cannot decrypt on Windows.

# Option A - Use browser cookies live (requires the browser to be CLOSED):
# Set to: chrome, firefox, edge, opera, brave, vivaldi, safari
# WARNING: Browsers lock their cookie database while running, causing errors.
# NOTE: Brave/Chrome DPAPI encryption is NOT supported by yt-dlp.
# COOKIE_BROWSER=brave

# Option B - Export cookies to a file (RECOMMENDED only for Firefox/Edge):
# 1. Close your browser completely
# 2. Run this command in the BottedFicus folder:
#    yt-dlp --cookies-from-browser edge --cookies data/cookies.txt
#    (use firefox if you use Firefox)
# 3. The bot will automatically detect data/cookies.txt
