# Discord bot token (required)
# Get it from: https://discord.com/developers/applications → Your App → Bot → Token
# DISCORD_TOKEN=

# Bot prefix (optional, default: !bp)
BOT_PREFIX=/bp

# Bot name (optional, default: BottedPlant)
# BOT_NAME=BottedPlant

# YouTube bypass for bot detection
# The bot now automatically detects cookies in data/cookies.txt
# If no cookies are found, it falls back to the embed hack (less reliable)

# Option A - Use browser cookies live (requires the browser to be CLOSED):
# Set to: chrome, firefox, edge, opera, brave, vivaldi, safari
# WARNING: Browsers lock their cookie database while running, causing errors.
# NOTE: Brave/Chrome DPAPI encryption is NOT supported by yt-dlp.
# COOKIE_BROWSER=brave
  
# Option B - Custom cookie file location (overrides Options A & B):  
# 1. Export your cookies to a custom location  
# 2. Set the path below (relative to project root or absolute)  
YTDLP_COOKIES_FILE=data/cookies-yt.txt 