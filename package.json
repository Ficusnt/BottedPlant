{
  "name": "bottedplant",
  "version": "1.8.0",
  "description": "Discord bot for YouTube audio and reminders — with a native slash command menu.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --optimize-for-size src/index.js",
    "start:prod": "node --max-old-space-size=256 --optimize-for-size dist/index.js",
    "dev": "node --max-old-space-size=256 --optimize-for-size scripts/dev.js",
    "build": "node scripts/build.js",
    "build:dev": "node scripts/build.js --dev",
    "test": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "doc": "jsdoc -c jsdoc.json",
    "postinstall": "node scripts/setup-ytdlp-conf.js",
    "setup": "node scripts/setup-ytdlp-conf.js",
    "generate-cookies": "node scripts/generate-cookies.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@distube/soundcloud": "^2.0.4",
    "@distube/yt-dlp": "^2.0.1",
    "discord.js": "^14.27.0",
    "distube": "^5.2.3",
    "dotenv": "^16.6.1",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.0.8",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@swc/jest": "^0.2.36",
    "@types/node": "^20.14.0",
    "esbuild": "^0.23.0",
    "eslint": "^10.13.0",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.3",
    "typescript": "^5.4.0"
  },
  "allowScripts": {
    "@distube/yt-dlp@2.0.1": true,
    "ffmpeg-static@5.3.0": true,
    "@parcel/watcher@2.6.0": true
  }
}
